# Copie este arquivo como .env. Nunca commite o .env nem credenciais reais.
# Todos os campos sensíveis abaixo ficam vazios de propósito.

# Servidor
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
COMPANY_CONFIG_PATH=./config/company.example.json
STORAGE_DRIVER=memory
SQLITE_PATH=./data/yolo-hub.sqlite
AGENT_ID=
AGENT_RELEASE_VERSION=
AGENT_RELEASE_MANIFEST_SHA256=
AGENT_RELEASES_ROOT=./config/releases
REQUIRE_RELEASE_SIGNATURE=false
RELEASE_TRUSTED_PUBLIC_KEYS=
TENANT_REGISTRY_PATH=
DEFAULT_TENANT_ID=empresa-modelo
SIMULATOR_TENANT_TOKENS=
DEMO_HOSTED=false
ENABLE_SIMULATOR=true
ENABLE_DEBUG_ENDPOINTS=true
CORS_ALLOWED_ORIGINS=
SIMULATOR_API_TOKEN=
SIMULATOR_RATE_LIMIT_MAX=60
SIMULATOR_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
WEBHOOK_PROCESSING_MODE=sync

# OpenAI (opcional; sem a chave o modo determinístico continua funcionando)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=12000

# Meta / WhatsApp Cloud API
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_SEND_ENABLED=false
REQUIRE_WEBHOOK_SIGNATURE=false
