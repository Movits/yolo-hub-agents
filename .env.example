# Servidor
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
COMPANY_CONFIG_PATH=./config/company.example.json
ENABLE_SIMULATOR=true
ENABLE_DEBUG_ENDPOINTS=true
WEBHOOK_PROCESSING_MODE=sync

# OpenAI (opcional; sem a chave o modo determinístico continua funcionando)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=12000

# Meta / WhatsApp Cloud API
META_GRAPH_VERSION=v25.0
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-longo-e-aleatorio
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_SEND_ENABLED=false
REQUIRE_WEBHOOK_SIGNATURE=false
